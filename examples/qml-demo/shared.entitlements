<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The app and its broadcast extension share one keychain group: the settings for sharing the whole screen. -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)local.rcsdk.qmldemo.shared</string>
    </array>
</dict>
</plist>
